# Operations env for deploy tooling (scripts/kindle.sh) and secret rotation.
# Copy to .env and fill in real values. .env is git-ignored — never commit it.
#
# Note: these are separate from worker/.dev.vars, which holds the Worker's local
# dev secrets (MS credentials). TODO_TOKEN must be the SAME in all three places:
# this .env, worker/.dev.vars, and the deployed Cloudflare secret.

# Access token gating the Worker (the Kindle and the page pass it as ?t=...).
# Rotate with:  openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
# then push it:  cd worker && printf '%s' "$TODO_TOKEN" | wrangler secret put TODO_TOKEN
TODO_TOKEN="choose-a-long-random-string"

# --- Kindle device (so you never have to scan the LAN for it again) ---

# The Kindle's LAN IP. Find it once: it runs a Dropbear SSH server on port 22.
#   nmap -p22 --open 192.168.1.0/24        (or check your router's DHCP leases)
KINDLE_IP="192.168.1.44"

# The Kindle's SSH (root) password — the USBNetLite password.
# Set/change it on the device in /mnt/us/usbnetlite/etc/config, then reboot.
KINDLE_SSH_PASS="kindle"

# Frontlight brightness, 0 = off .. 24 = max. `scripts/kindle.sh deploy` writes
# this to the device; e-ink is readable at 0 in a lit room, so 0 is a fine
# default. Bump it for a dim hallway, then re-run deploy.
KINDLE_FLINTENSITY=0

# --- Optional cadence / power overrides (all have defaults on the device) ---
# Any KINDLE_<NAME> here is written as <NAME> into the device's config.local by
# `scripts/kindle.sh deploy` and `scripts/stage-usb.sh`. See
# extensions/kindletodo/bin/config.example.sh for what each one does.
# KINDLE_TZ="CET-1CEST,M3.5.0,M10.5.0/3"   # POSIX TZ for the night window
# KINDLE_NIGHT_START="22:30"               # hourly on-the-hour polls from here...
# KINDLE_NIGHT_END="06:00"                 # ...until here (local time)
# KINDLE_NIGHT_OFFSET=90                   # seconds past the hour (0 = exactly on the hour)
# KINDLE_BATTERY_INTERVAL=300              # poll interval while discharging
# KINDLE_BATTERY_LOW_INTERVAL=900          # ...and below KINDLE_BATT_THRESHOLD %
# KINDLE_BATT_THRESHOLD=20
# KINDLE_BATT_CRITICAL=5                   # clean power-off at/below this %
# KINDLE_SUSPEND=1                         # 0 = never suspend (keeps SSH reachable)
# KINDLE_WIFI_SSID="MyNetwork"             # network the kiosk re-joins after a resume
# KINDLE_WIFI_PSK="the-password"           # so it can re-create the profile wifid deletes after failed handshakes
# KINDLE_GATEWAY="192.168.1.1"             # default route to restore if it goes missing after a resume
# KINDLE_WIFI_WAIT=60                      # seconds to keep trying (the recovery ladder needs ~40)
# KINDLE_WIFI_RADIO_OFF=1                  # radio off across suspends, fresh join after wake
# KINDLE_SUSPEND_ON_CHARGER=0              # never suspend while charging
# KINDLE_REBOOT_AFTER_FAILS=6              # reboot after N consecutive polls with Wi-Fi provably down (0 = never)
